{
  "maxTickers": 50,
  "maxCandidates": 3,
  "allowNetwork": false,
  "dryRun": true,
  "seedMode": "local-plus-config",
  "yahooRequestDelayMs": 2000,
  "yahooMaxRetries": 2,
  "yahooRetryBaseDelayMs": 5000,
  "yahooCacheTtlMinutes": 15,
  "useLocalCsvFallback": true,
  "sourcesEnabled": {
    "yahoo": true,
    "nasdaq": true,
    "sec": true,
    "openinsider": false,
    "openfda": true,
    "finviz": false,
    "earnings": true
  },
  "universeSeeds": [
    "VKTX",
    "ACHV",
    "VRDN",
    "OCS",
    "AXSM",
    "IPX",
    "U",
    "AMZN",
    "GOOGL"
  ],
  "includeEtfs": true,
  "includeBiotech": true,
  "includeEarnings": true,
  "includeInsiders": true,
  "minPrice": 2,
  "minDollarVolume": 10000000,
  "minRelativeVolume": 1.25,
  "outputDir": "backtests/live-universe-scan",
  "dryRunNotes": "Fase 2: Yahoo puede rate-limitear. El scanner ahora usa delay, retry, cache local y fallback CSV opcional sin tratarlo como live real."
}
